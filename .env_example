# 基本配置
APP_NAME=interactive-bot
BOT_TOKEN=7126xxxxxxxxxxxxxxxxxxxf4He_BbQ
# 定时任务（每日汇总）使用的时区
BOT_TIMEZONE=Asia/Shanghai

# 业务配置
# 首次 /start 时发给用户的欢迎语。支持 HTML，别写多行。
# 建议保留"发 /help 看说明"这句，用户才找得到 /stop 和 /privacy。
WELCOME_MESSAGE="你好，请直接发送你要说的内容。发 /help 可以看使用说明。"
# 后台群组 ID 与管理员用户 ID，用 @GetTheirIDBot 获取
# 这两项必须换成自己的，否则机器人无法发消息到后台、管理命令也会全部无效
ADMIN_GROUP_ID=-1001234567890
ADMIN_USER_IDS=123456789

# 删除话题时是否永久封禁（无法恢复了） TRUE 开启
DELETE_TOPIC_AS_FOREVER_BAN=FALSE

# 利用 /clear 清理后台和用户侧的所有消息（不推荐） TRUE 开启
DELETE_USER_MESSAGE_ON_CLEAR_CMD=TRUE

# 是否禁用人机识别 TRUE 禁用
DISABLE_CAPTCHA=FALSE

# 连续刷屏时的最小间隔（秒），0 为不限制。
# 令牌桶：前 8 条立即放行，第 9 条起才按这个间隔排。所以"5 张图一张一张发"
# 完全不等；超了是排队等一会，不丢弃，也不影响其他用户。
MESSAGE_INTERVAL=5
